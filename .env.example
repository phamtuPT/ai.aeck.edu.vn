# MongoDB Connection Strings
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aeckdb?retryWrites=true&w=majority"
MONGODB_URI_CHATBOT="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aeckdb_chatbot?retryWrites=true&w=majority"

# Note: The Google GenAI API Key is handled client-side and stored in local storage.
# It is NOT required as a server-side environment variable.

# (Tùy chọn) Vector search cho tài liệu đề thi.
# text-embedding-004 đã bị Google tắt. Chỉ đặt biến này sau khi đã tạo lại embedding
# cho aeckdb.exams bằng đúng mô hình này (và tạo lại vector_index với số chiều tương ứng).
# GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
# GEMINI_EMBEDDING_DIMENSIONS="768"
